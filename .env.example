# Copy to .env and fill in. Never commit a real .env file to git.

# Port the app listens on locally. Render sets its own PORT automatically.
PORT=3000

# Database: leave empty for local SQLite (zero config). Set to your Neon
# Postgres connection string for hosted deploys (required on Render, where
# the SQLite file would be wiped on every restart/redeploy).
DATABASE_URL=

# Login mode: password (phone or username + password) or otp (6-digit code).
AUTH_MODE=password

# How OTP codes are delivered when AUTH_MODE=otp: dev prints the code to the
# server console (local testing only); whatsapp sends it via the WhatsApp
# Cloud API (requires the WHATSAPP_* vars below and costs money per message).
OTP_PROVIDER=dev

# WhatsApp Cloud API phone number ID (from Meta developer dashboard).
WHATSAPP_PHONE_NUMBER_ID=

# Permanent WhatsApp Cloud API access token. Keep this secret, like a password.
WHATSAPP_TOKEN=

# Name of your approved authentication template (default in the app: otp_code).
WHATSAPP_TEMPLATE=otp_code

# Extra secret mixed into stored OTP code hashes. Optional, but set a long
# random string in production for defense in depth.
OTP_PEPPER=

# Username for the first-boot admin account. Default: admin.
ADMIN_USER=admin

# Optional: preset the admin's one-time claim token yourself instead of
# letting the app generate a random one. If unset, the app prints a random
# one-time claim URL to the console on first boot.
ADMIN_CLAIM_TOKEN=
