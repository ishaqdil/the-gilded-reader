<div class="auth-wrap">
  <div class="card auth-card">
    <h1>The Gilded Cage</h1>
    <p class="muted"><%= authMode === 'otp' ? 'Log in with your phone number.' : 'Welcome back, reader.' %></p>
    <% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %>
    <% if (info) { %><p class="alert alert-ok" role="status"><%= info %></p><% } %>

    <% if (authMode === 'otp' && step === 'verify') { %>
      <form action="/api/otp/verify" method="post" novalidate>
        <input type="hidden" name="purpose" value="login">
        <input type="hidden" name="phone" value="<%= phone %>">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label for="code">6-digit code</label>
          <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required>
          <p class="hint">We sent it to <%= phone %> · expires in 10 minutes</p>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Verify &amp; log in</button>
      </form>
      <p class="auth-switch"><a class="link" href="/login">← Use a different number</a></p>
    <% } else if (authMode === 'otp') { %>
      <form action="/login" method="post" novalidate>
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label for="phone">Phone number</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+923001234567" value="<%= phone %>" required>
          <p class="hint">With country code, e.g. +923001234567</p>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send code</button>
      </form>
      <p class="auth-switch">No account yet? <a class="link" href="/register">Create one</a></p>
    <% } else { %>
      <form action="/login" method="post" novalidate>
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label for="identifier">Username or phone number</label>
          <input id="identifier" name="identifier" type="text" autocomplete="username" value="<%= phone %>" required>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Log in</button>
      </form>
      <p class="auth-switch">No account yet? <a class="link" href="/register">Create one</a></p>
    <% } %>
  </div>
</div>
