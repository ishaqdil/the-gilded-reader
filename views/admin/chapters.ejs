<div class="page-head split">
  <div>
    <h1>Chapters</h1>
    <p class="muted"><%= chapters.length %> chapter<%= chapters.length === 1 ? '' : 's' %> total</p>
  </div>
  <a class="btn btn-primary" href="/admin/chapters/new">＋ New chapter</a>
</div>

<% if (chapters.length) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>#</th><th>Title</th><th>Status</th><th>Comments</th><th>Updated</th><th><span class="sr-only">Actions</span></th></tr></thead>
      <tbody>
        <% chapters.forEach((c) => { %>
          <tr>
            <td data-label="#"><%= c.number %></td>
            <td data-label="Title"><a class="link" href="/chapter/<%= c.id %>"><%= c.title %></a></td>
            <td data-label="Status"><% if (c.published) { %><span class="badge badge-ok">published</span><% } else { %><span class="badge">draft</span><% } %></td>
            <td data-label="Comments"><%= c.comment_count %></td>
            <td data-label="Updated" class="muted small"><%= fmtDate(c.updated_at) %></td>
            <td class="row-actions">
              <a class="btn btn-ghost btn-sm" href="/admin/chapters/<%= c.id %>/edit">Edit</a>
              <form action="/admin/chapters/<%= c.id %>/delete" method="post" class="inline" data-confirm="Delete Chapter <%= c.number %>? Its comments will also be removed.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger-ghost btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="empty-state">
    <p class="empty-icon" aria-hidden="true">📝</p>
    <h2>No chapters yet</h2>
    <p class="muted">Publish your first chapter to get the story started.</p>
    <a class="btn btn-primary" href="/admin/chapters/new">＋ New chapter</a>
  </div>
<% } %>
